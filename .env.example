# --- Copy this file to .env and adjust the secrets -------------------------
# docker compose reads this file automatically.

# Database password (also used inside the DATABASE_URL). Keep it URL-safe.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# JWT signing key. Generate with: openssl rand -hex 32
TRAVELTRACE_SECRET_KEY=change-me-to-a-long-random-string

# Web entry point. Open http://localhost:8080 after `docker compose up -d`.
TRAVELTRACE_PORT=8080

# --- Application behaviour -------------------------------------------------
# Allow new accounts to register. Set to false after creating your account.
TRAVELTRACE_ALLOW_REGISTRATION=true

# Reverse geocoding is privacy-sensitive and disabled by default.
# Set to `nominatim` to enable lookups against OpenStreetMap's public service.
TRAVELTRACE_GEOCODING_PROVIDER=none

# Background processing: `celery` (Redis + worker, default) or `thread`.
TRAVELTRACE_TASK_BACKEND=celery

# Extra origins allowed to call the API directly (comma separated).
# TRAVELTRACE_CORS_ORIGINS=http://localhost:8080

# Map style for the frontend build. Point this at your own MapLibre style in
# production if you do not want to rely on the public OpenFreeMap instance.
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
